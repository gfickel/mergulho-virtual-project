/* Beaches screen (UI Toolkit, Phase 3 strangler slice).
 * Token discipline applies here exactly as in DesignSystem/Components:
 * only var(--md-*) colors, no literals (TokenDisciplineTests scans Assets/UI too). */

.mv-beaches {
    flex-grow: 1;
}

/* Opaque surface; the root stays transparent so the reserved BottomNav strip
 * below this container never paints over (or blocks taps to) the uGUI nav. */
.mv-beaches__content {
    flex-grow: 1;
    background-color: var(--md-sys-color-background);
}

.mv-beaches__pane {
    flex-grow: 1;
}

.mv-beaches__selector {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 12px;
}

.mv-beaches__scroll {
    flex-grow: 1;
}

/* ---- Beach photo cards (list) ---- */

.mv-beach-card {
    margin-left: 16px;
    margin-right: 16px;
    margin-bottom: 12px;
    border-radius: var(--md-sys-shape-corner-large);
    overflow: hidden;
    background-color: var(--md-sys-color-surface-container-low);
}

.mv-beach-card__media {
    height: 140px;
}

.mv-beach-card__media--placeholder {
    background-color: var(--md-sys-color-surface-container-highest);
    align-items: center;
    justify-content: center;
}

.mv-beach-card__placeholder-icon {
    font-size: 48px;
    color: var(--md-sys-color-on-surface-variant);
}

.mv-beach-card__text {
    padding: 12px 16px 14px 16px;
}

.mv-beach-card__title {
    color: var(--md-sys-color-on-surface);
}

.mv-beach-card__subtitle {
    margin-top: 2px;
    color: var(--md-sys-color-on-surface-variant);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mv-beach-card .md-state-layer {
    background-color: var(--md-sys-color-on-surface);
}

.mv-beach-card:hover .md-state-layer {
    opacity: var(--md-sys-state-hover-opacity);
}

.mv-beach-card:focus .md-state-layer {
    opacity: var(--md-sys-state-focus-opacity);
}

.mv-beach-card:active .md-state-layer {
    opacity: var(--md-sys-state-pressed-opacity);
}

.mv-beaches__detail-scroll {
    flex-grow: 1;
}

.mv-beaches__detail-content {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 24px;
}

.mv-beaches__detail-content > * {
    margin-bottom: 12px;
}

.mv-beaches__hero {
    height: 200px;
    border-radius: var(--md-sys-shape-corner-large);
    overflow: hidden;
}

.mv-beaches__hero-image {
    flex-grow: 1;
}

.mv-beaches__description {
    white-space: normal;
    color: var(--md-sys-color-on-surface);
}

.mv-beaches__credit {
    white-space: normal;
    color: var(--md-sys-color-on-surface-variant);
    margin-top: -8px;
}

.mv-beaches__card-title {
    margin-bottom: 8px;
    color: var(--md-sys-color-on-surface);
}

.mv-beaches__row {
    flex-direction: row;
    margin-top: 6px;
}

.mv-beaches__row-label {
    width: 72px;
    flex-shrink: 0;
    color: var(--md-sys-color-on-surface-variant);
}

.mv-beaches__row-value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: var(--md-sys-color-on-surface);
}

.mv-beaches__freshness {
    margin-top: 12px;
    color: var(--md-sys-color-on-surface-variant);
}

.mv-beaches__sparkline {
    height: 120px;
}

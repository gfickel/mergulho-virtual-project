/* M3 top app bar — https://m3.material.io/components/top-app-bar/specs
 * Heights: small/center-aligned 64dp, medium 112dp, large 152dp.
 * 4dp horizontal padding (icon buttons carry their own 4dp internal inset,
 * landing the icons at the spec's 16dp edge distance).
 */

.md-top-app-bar {
    background-color: var(--md-sys-color-surface);
    padding-left: 4px;
    padding-right: 4px;
}

.md-top-app-bar__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 64px;
}

.md-top-app-bar__nav .md-icon {
    color: var(--md-sys-color-on-surface);
}

/* In-row title: M3 title-large. Shown for small/center-aligned only. */
.md-top-app-bar__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 8px;
    margin-right: 8px;
    font-size: 22px;
    color: var(--md-sys-color-on-surface);
    -unity-font-definition: url("/Assets/DesignSystem/Fonts/Inter-Regular.asset");
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.md-top-app-bar--center-aligned .md-top-app-bar__title {
    -unity-text-align: middle-center;
}

.md-top-app-bar__actions {
    flex-direction: row;
    align-items: center;
}

/* Second-line headline: shown for medium/large, bottom-aligned in the
 * remaining container height. 12px margin + the root's 4px = 16dp edge. */
.md-top-app-bar__headline {
    display: none;
    flex-grow: 1;
    margin-left: 12px;
    margin-right: 12px;
    color: var(--md-sys-color-on-surface);
    -unity-font-definition: url("/Assets/DesignSystem/Fonts/Inter-Regular.asset");
    -unity-text-align: lower-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.md-top-app-bar--medium {
    min-height: 112px;
}
.md-top-app-bar--medium .md-top-app-bar__title {
    display: none;
}
.md-top-app-bar--medium .md-top-app-bar__headline {
    /* M3 headline-small */
    display: flex;
    font-size: 24px;
    margin-bottom: 24px;
}

.md-top-app-bar--large {
    min-height: 152px;
}
.md-top-app-bar--large .md-top-app-bar__title {
    display: none;
}
.md-top-app-bar--large .md-top-app-bar__headline {
    /* M3 headline-medium */
    display: flex;
    font-size: 28px;
    margin-bottom: 28px;
}

/* M3 top app bar — https://m3.material.io/components/top-app-bar/specs
 * Heights: small/center-aligned 64dp, medium 112dp, large 152dp.
 * 4dp horizontal padding (icon buttons carry their own 4dp internal inset,
 * landing the icons at the spec's 16dp edge distance).
 */

.md-top-app-bar {
    background-color: var(--md-sys-color-surface);
    padding-left: 4px;
    padding-right: 4px;
}

.md-top-app-bar__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 64px;
}

.md-top-app-bar__nav .md-icon {
    color: var(--md-sys-color-on-surface);
}

/* In-row title: shown for small/center-aligned only.
 * NO font metrics here on purpose — MdTopAppBar.cs puts `.md-typescale-title-large`
 * on the label, so the brand's 20/700 is the single source. Stock M3's 22/400 is
 * what used to be hard-coded here, which every consumer then had to re-patch
 * locally (ReportScreen.uss still does). */
.md-top-app-bar__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 8px;
    margin-right: 8px;
    color: var(--md-sys-color-on-surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* CENTRED ON THE BAR, NOT ON THE GAP BETWEEN THE SLOTS
 * In flow, `flex-grow: 1` + `middle-center` centres the title inside whatever is
 * left over between the nav and action slots — so one leading icon against two
 * trailing ones pushed the string ~13dp off the bar's own centre. Taking the title
 * out of flow and insetting it by one 48dp icon slot on EACH side makes its centre
 * the bar's centre whatever the slots hold. `top/bottom: 0` + `middle-center` does
 * the vertical centring too, rather than relying on how Yoga aligns an absolutely
 * positioned child.
 * The actions slot is pinned to the right edge for the same reason: with the title
 * out of flow, the row's `space-between` would otherwise put a lone actions slot at
 * the LEFT whenever there is no navigation icon.
 * Trade-off: the title's box runs to 48dp from each edge, so a long title under a
 * SECOND trailing action would slide beneath it (M3's centre-aligned bar carries one
 * trailing icon). It ellipsizes before the bar edge either way.
 * Also: with title AND actions out of flow, a centre-aligned bar no longer measures
 * its own width from its content. It must be stretched or given one — which is what
 * a bar docked at the top of a screen (or the gallery's explicit 380) already is. */
.md-top-app-bar--center-aligned .md-top-app-bar__title {
    position: absolute;
    left: 48px;
    right: 48px;
    top: 0;
    bottom: 0;
    margin-left: 0;
    margin-right: 0;
    -unity-text-align: middle-center;
}

.md-top-app-bar--center-aligned .md-top-app-bar__actions {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
}

.md-top-app-bar__actions {
    flex-direction: row;
    align-items: center;
}

/* Second-line headline: shown for medium/large, bottom-aligned in the
 * remaining container height. 12px margin + the root's 4px = 16dp edge. */
.md-top-app-bar__headline {
    display: none;
    flex-grow: 1;
    margin-left: 12px;
    margin-right: 12px;
    color: var(--md-sys-color-on-surface);
    -unity-font-definition: url("/Assets/DesignSystem/Fonts/Inter-Regular.asset");
    -unity-text-align: lower-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.md-top-app-bar--medium {
    min-height: 112px;
}
.md-top-app-bar--medium .md-top-app-bar__title {
    display: none;
}
.md-top-app-bar--medium .md-top-app-bar__headline {
    /* M3 headline-small */
    display: flex;
    font-size: 24px;
    margin-bottom: 24px;
}

.md-top-app-bar--large {
    min-height: 152px;
}
.md-top-app-bar--large .md-top-app-bar__title {
    display: none;
}
.md-top-app-bar--large .md-top-app-bar__headline {
    /* M3 headline-medium */
    display: flex;
    font-size: 28px;
    margin-bottom: 28px;
}

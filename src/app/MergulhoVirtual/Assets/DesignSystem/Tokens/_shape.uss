/* M3 shape scale — https://m3.material.io/styles/shape/shape-scale-tokens
 * Consume as: border-radius: var(--md-sys-shape-corner-medium);
 * "full" (pill) uses a large px value; UI Toolkit clamps radius to half the
 * element's smaller dimension, which yields the pill shape.
 */
:root {
    --md-sys-shape-corner-none: 0;
    --md-sys-shape-corner-extra-small: 4px;
    --md-sys-shape-corner-small: 8px;
    --md-sys-shape-corner-medium: 12px;
    --md-sys-shape-corner-large: 16px;
    --md-sys-shape-corner-extra-large: 28px;
    --md-sys-shape-corner-full: 1000px;
}
